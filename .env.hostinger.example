# Copiar a .env en el servidor y completar los valores

APP_NAME="Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ramironuva.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Base de datos MySQL (Hostinger)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u671466050_portfolio
DB_USERNAME=u671466050_ramironuva
DB_PASSWORD=tu_password_mysql

# Sesiones y caché (usar base de datos en shared hosting)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail (OBLIGATORIO para notificaciones del formulario)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@ramironuva.com
MAIL_PASSWORD=tu_password_email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@ramironuva.com"
MAIL_FROM_NAME="${APP_NAME}"

# Lead automation (opcional)
# LEAD_WEBHOOK_URL=
# BREVO_API_KEY=
# BREVO_LEADS_LIST_ID=
# Con QUEUE_CONNECTION=sync, los follow-ups se envían TODOS de inmediato (5+ emails). Desactivar:
LEAD_FOLLOWUP_EMAILS=false
# CALENDLY_API_TOKEN=
