# Copiar a .env en el servidor y completar los valores
#
# Imágenes: si las fotos dan 404, ejecuta en el servidor:
#   php artisan storage:migrate-to-public

APP_NAME="Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ramironuva.com
ADMIN_EMAILS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Base de datos MySQL (Hostinger)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesiones y caché (usar base de datos en shared hosting)
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# SMTP para notificaciones internas opcionales
CONTACT_NOTIFY_ADMIN=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead automation (opcional)
# LEAD_WEBHOOK_URL=
# BREVO_API_KEY=
# BREVO_LEADS_LIST_ID=
LEAD_FOLLOWUP_EMAILS=false
CALENDLY_WEBHOOK_SIGNING_KEY=
